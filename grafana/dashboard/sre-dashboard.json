{
    "title": "SRE Starter Dashboard",
    "panels": [
      {
        "type": "timeseries",
        "title": "Request Rate",
        "targets": [
          {
            "expr": "sum(rate(http_requests_total[1m])) by (http_method)"
          }
        ],
        "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 }
      },
      {
        "type": "timeseries",
        "title": "Latency (p50 / p95 / p99)",
        "targets": [
          {
            "expr": "histogram_quantile(0.50, sum(rate(http_server_duration_milliseconds_bucket[5m])) by (le, http_status_code))",
            "legendFormat": "p50"
          },
          {
            "expr": "histogram_quantile(0.95, sum(rate(http_server_duration_milliseconds_bucket[5m])) by (le, http_status_code))",
            "legendFormat": "p95"
          },
          {
            "expr": "histogram_quantile(0.99, sum(rate(http_server_duration_milliseconds_bucket[5m])) by (le, http_status_code))",
            "legendFormat": "p99"
          }
        ],
        "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 }
      },
      {
        "type": "stat",
        "title": "Firing Alerts",
        "targets": [
          {
            "expr": "count(ALERTS{alertstate=\"firing\"})"
          }
        ],
        "gridPos": { "x": 0, "y": 8, "w": 24, "h": 6 }
      },
      {
        "type": "timeseries",
        "title": "CPU Usage %",
        "targets": [
          {
            "expr": "100 - (avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[2m])) * 100)"
          }
        ],
        "gridPos": { "x": 0, "y": 14, "w": 8, "h": 6 }
      },
      {
        "type": "timeseries",
        "title": "Memory Usage %",
        "targets": [
          {
            "expr": "(node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes) / node_memory_MemTotal_bytes * 100"
          }
        ],
        "gridPos": { "x": 8, "y": 14, "w": 8, "h": 6 }
      },
      {
        "type": "timeseries",
        "title": "Disk Usage %",
        "targets": [
          {
            "expr": "(node_filesystem_size_bytes{fstype!~\"tmpfs|overlay\"} - node_filesystem_free_bytes{fstype!~\"tmpfs|overlay\"}) / node_filesystem_size_bytes{fstype!~\"tmpfs|overlay\"} * 100",
            "legendFormat": "{{instance}}"
          }
        ],
        "gridPos": { "x": 16, "y": 14, "w": 8, "h": 6 }
      }
    ],
    "schemaVersion": 38,
    "version": 1
  }